{
  "name": "dsh-whale-tide",
  "version": "0.3.0",
  "description": "Whale and fish schools swim across DeepSeek Harness, with the full dsh-ascii-whales control set and a dsh-quiet ebb in conversation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "vendor"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "icon.svg",
  "scripts": {
    "test": "node --test test/settings.test.js test/manifest.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "canvas",
    "ascii",
    "whale",
    "boids",
    "ambient"
  ],
  "license": "MIT",
  "author": "MinEagle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinEagle/dsh-whale-tide.git"
  },
  "homepage": "https://github.com/MinEagle/dsh-whale-tide#readme",
  "bugs": {
    "url": "https://github.com/MinEagle/dsh-whale-tide/issues"
  }
}
