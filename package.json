  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/zh.json": "./locale/zh.json",
    "./locale/en.json": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/settings.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE.dsh-quiet",
    "LICENSE",
    "LICENSE.dsh-ascii-whales"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "canvas",
    "whale",
    "typewriter",
    "streaming",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinEagle/dsh-whale-tide.git"
  },
  "homepage": "https://github.com/MinEagle/dsh-whale-tide#readme",
